<Window x:Class="IluPrompter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:IluPrompter.App.Views"
        xmlns:c="clr-namespace:IluPrompter.App.Controls"
        xmlns:interop="clr-namespace:IluPrompter.App.Interop"
        xmlns:t="clr-namespace:IluPrompter.Theme;assembly=IluPrompter.Theme"
        Style="{StaticResource Ilu.Window}" interop:DarkTitleBar.IsEnabled="True"
        Title="{Binding WindowTitle}" MinWidth="1024" MinHeight="600" Width="1280" Height="800"
        WindowState="Maximized" SizeChanged="OnSizeChanged" Closing="OnClosing">
  <!-- DESIGN.md "Layout": regions A (app bar), B (sections), C (editor), D (live column), G (status bar). The window
       background is canvas from the first frame, so it never flashes white. DataContext: MainViewModel. -->
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static v:AppCommands.NewScript}" Executed="OnNew"/>
    <CommandBinding Command="{x:Static v:AppCommands.OpenScript}" Executed="OnOpen"/>
    <CommandBinding Command="{x:Static v:AppCommands.SaveScript}" Executed="OnSave"/>
    <CommandBinding Command="{x:Static v:AppCommands.SaveScriptAs}" Executed="OnSaveAs"/>
    <CommandBinding Command="{x:Static v:AppCommands.ShowSettings}" Executed="OnShowSettings"/>
    <CommandBinding Command="{x:Static v:AppCommands.ShowShortcuts}" Executed="OnShowShortcuts"/>
    <CommandBinding Command="{x:Static v:AppCommands.GoToScript}" Executed="OnGoToScript"/>
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="{StaticResource Ilu.Grid.AppBar}"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="{StaticResource Ilu.Grid.StatusBar}"/>
    </Grid.RowDefinitions>

    <!-- A: app bar -->
    <Border Background="{StaticResource Ilu.Brush.Backdrop}" BorderBrush="{StaticResource Ilu.Brush.Line}" BorderThickness="0,0,0,1">
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Menu VerticalAlignment="Center">
          <MenuItem Header="File">
            <MenuItem Header="New script" Command="{x:Static v:AppCommands.NewScript}"/>
            <MenuItem Header="Open script…" Command="{x:Static v:AppCommands.OpenScript}"/>
            <MenuItem Header="Open recent" ItemsSource="{Binding Recent}" IsEnabled="{Binding HasRecent}">
              <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource Ilu.MenuItem}">
                  <Setter Property="Header" Value="{Binding Name}"/>
                  <Setter Property="ToolTip" Value="{Binding Path}"/>
                  <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                  <Setter Property="CommandParameter" Value="{Binding Path}"/>
                </Style>
              </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Save script" Command="{x:Static v:AppCommands.SaveScript}"/>
            <MenuItem Header="Save script as…" Command="{x:Static v:AppCommands.SaveScriptAs}"/>
            <MenuItem Header="Export script…" Command="{Binding ExportScriptCommand}"/>
            <Separator/>
            <MenuItem Header="Exit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}"/>
          </MenuItem>
          <MenuItem Header="Edit">
            <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="OnUndo"/>
            <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="OnRedo"/>
            <Separator/>
            <MenuItem Header="Cut" InputGestureText="Ctrl+X" Click="OnCut"/>
            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="OnCopy"/>
            <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="OnPaste"/>
            <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="OnSelectAll"/>
            <Separator/>
            <MenuItem Header="Find" InputGestureText="Ctrl+F" Click="OnFind"/>
          </MenuItem>
          <MenuItem Header="Script">
            <MenuItem Header="Insert section marker" InputGestureText="Ctrl+Shift+Enter" Click="OnInsertSection"/>
            <MenuItem Header="Clear formatting" InputGestureText="Ctrl+Space" Click="OnClearFormatting"/>
            <MenuItem Header="Larger text" InputGestureText="Ctrl+]" Click="OnLarger"/>
            <MenuItem Header="Smaller text" InputGestureText="Ctrl+[" Click="OnSmaller"/>
            <Separator/>
            <MenuItem Header="Go to the script" Command="{x:Static v:AppCommands.GoToScript}"/>
            <MenuItem Header="Jump to start" InputGestureText="Home" Click="OnJumpToStart"/>
          </MenuItem>
          <MenuItem Header="Output">
            <MenuItem Header="Show or hide output" InputGestureText="F11" Command="{Binding ToggleOutputCommand}"/>
            <MenuItem Header="Blank output" InputGestureText="F8" Command="{Binding ToggleBlankCommand}"/>
            <Separator/>
            <MenuItem Header="Output settings…" Click="OnOutputSettings"/>
          </MenuItem>
          <MenuItem Header="Help">
            <MenuItem Header="Shortcut list" Command="{x:Static v:AppCommands.ShowShortcuts}"/>
            <MenuItem Header="Settings…" Command="{x:Static v:AppCommands.ShowSettings}"/>
            <Separator/>
            <MenuItem Header="About ILU Prompter" Click="OnAbout"/>
          </MenuItem>
        </Menu>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Border Width="1" Height="20" Background="{StaticResource Ilu.Brush.Line}" Margin="0,0,16,0"/>
          <TextBlock Text="{Binding ScriptName}" Style="{StaticResource Ilu.Text.Label}" Foreground="{StaticResource Ilu.Brush.TextStrong}" VerticalAlignment="Center"/>
          <TextBlock Text=" &#x00B7; " Style="{StaticResource Ilu.Text.Caption}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding SavedText}" Style="{StaticResource Ilu.Text.Caption}" Foreground="{StaticResource Ilu.Brush.Text}" VerticalAlignment="Center"/>
          <!-- Below 1200 the chips move here from the live column -->
          <v:ChipsRow Margin="20,0,0,0" DataContext="{Binding Live}" VerticalAlignment="Center"
                      Visibility="{Binding Tier, Converter={x:Static c:TierToVisibilityConverter.Instance}, ConverterParameter=narrow}"/>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Ilu.Button.Secondary}" Height="36" MinHeight="36" Padding="14,0" Command="{Binding ToggleOutputCommand}"
                  ToolTip="Show the script on the presenter's display, or hide it (F11)" AutomationProperties.AcceleratorKey="F11"
                  AutomationProperties.Name="{Binding ShowOutputLabel}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ShowOutputLabel}" Style="{StaticResource Ilu.Text.Button}"/>
              <TextBlock Text="F11" Style="{StaticResource Ilu.Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Ilu.Button.Secondary}" Height="36" MinHeight="36" Width="36" Padding="0" Margin="8,0,0,0"
                  Command="{x:Static v:AppCommands.ShowSettings}" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings"
                  AutomationProperties.AcceleratorKey="Ctrl+,">
            <TextBlock Text="{x:Static t:IluIcons.Settings}" Style="{StaticResource Ilu.Text.Icon}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- B, C, D -->
    <Grid Grid.Row="1" Margin="{StaticResource Ilu.Pad.Window}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SectionsColumn" Width="240"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition x:Name="LiveColumnDefinition" Width="720"/>
      </Grid.ColumnDefinitions>

      <!-- B: sections panel (Wide) or the 44 px rail -->
      <v:SectionsPanel x:Name="SectionsWide" DataContext="{Binding Sections}"
                       AddSectionRequested="OnInsertSection" RenameRequested="OnRenameSection" DeleteRequested="OnDeleteSection"/>
      <Border x:Name="SectionsRail" Style="{StaticResource Ilu.Panel}" Padding="0" Visibility="Collapsed">
        <StackPanel Margin="5,8,5,0">
          <Button Style="{StaticResource Ilu.Button.Toolbar}" Width="32" Height="32" Click="OnToggleFlyout"
                  ToolTip="Sections" AutomationProperties.Name="Show the section list">
            <TextBlock Text="{x:Static t:IluIcons.Menu}" Style="{StaticResource Ilu.Text.Icon}"/>
          </Button>
          <Button Style="{StaticResource Ilu.Button.Toolbar}" Width="32" Height="32" Margin="0,4,0,0" Click="OnInsertSection"
                  ToolTip="Insert section marker (Ctrl+Shift+Enter)" AutomationProperties.Name="Insert section marker">
            <TextBlock Text="&#x00A7;+" Style="{StaticResource Ilu.Text.Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </StackPanel>
      </Border>

      <!-- C: editor -->
      <v:EditorPanel x:Name="EditorArea" Grid.Column="2"/>

      <!-- D: live column -->
      <v:LiveColumn x:Name="LiveArea" Grid.Column="4" DataContext="{Binding Live}"/>

      <!-- the sections list as a 280 px flyout over the editor (Esc or a jump closes it) -->
      <Grid x:Name="Flyout" Grid.ColumnSpan="5" Panel.ZIndex="20" Visibility="Collapsed">
        <Border Background="Transparent" MouseLeftButtonDown="OnFlyoutScrimDown"/>
        <v:SectionsPanel x:Name="SectionsFlyout" HorizontalAlignment="Left" Width="280" Margin="52,0,0,0" DataContext="{Binding Sections}"
                         AddSectionRequested="OnInsertSection" RenameRequested="OnRenameSection" DeleteRequested="OnDeleteSection"/>
      </Grid>
    </Grid>

    <!-- G: status bar -->
    <Border Grid.Row="2" Background="{StaticResource Ilu.Brush.Backdrop}" BorderBrush="{StaticResource Ilu.Brush.Line}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Esc hands the keys to the transport. F2 puts them back in the script.">
          <TextBlock Text="&#x2328;" Style="{StaticResource Ilu.Text.Glyph}" Foreground="{StaticResource Ilu.Brush.TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding KeyFocusText}" Style="{StaticResource Ilu.Text.Caption}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding PositionText}" Style="{StaticResource Ilu.Text.Mono}" FontSize="13" Foreground="{StaticResource Ilu.Brush.TextMuted}"
                   Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding WordsText}" Style="{StaticResource Ilu.Text.Mono}" FontSize="13" Foreground="{StaticResource Ilu.Brush.TextMuted}"
                   Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding NoteText}" Style="{StaticResource Ilu.Text.Caption}" Foreground="{StaticResource Ilu.Brush.Text}"
                   Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding OutputDisplayText}" Style="{StaticResource Ilu.Text.Caption}"/>
          <TextBlock Text=" &#x00B7; " Style="{StaticResource Ilu.Text.Caption}"/>
          <TextBlock Text="{Binding ControllerText}" Style="{StaticResource Ilu.Text.Caption}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
