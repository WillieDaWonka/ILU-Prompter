<Window x:Class="IluPrompter.App.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:IluPrompter.App.Interop"
        Style="{StaticResource Ilu.Window}" interop:DarkTitleBar.IsEnabled="True"
        Title="ILU Prompter" Width="460" SizeToContent="Height" MinWidth="360"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown" ContentRendered="OnContentRendered">
  <!-- The app's own dialog skin (DESIGN.md "Message boxes"): title in heading, one primary (verb + object),
       a secondary, never a bare OK or Yes/No, never the native white MessageBox. -->
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" Style="{StaticResource Ilu.Text.Title}" TextWrapping="Wrap"/>
    <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource Ilu.Text.Body}"/>
    <TextBox x:Name="PromptBox" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed" AutomationProperties.Name="Name"
             PreviewKeyDown="OnPromptKeyDown"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="Tertiary" Margin="0,0,8,0" Visibility="Collapsed" Click="OnTertiary"/>
      <Button x:Name="Secondary" Margin="0,0,8,0" Visibility="Collapsed" Click="OnSecondary"/>
      <Button x:Name="Primary" Style="{StaticResource Ilu.Button.Primary}" Click="OnPrimary"/>
    </StackPanel>
  </Grid>
</Window>
