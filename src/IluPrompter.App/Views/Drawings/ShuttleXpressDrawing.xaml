<UserControl x:Class="IluPrompter.App.Views.Drawings.ShuttleXpressDrawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource Ilu.Size.ControllerDesignWidth}" Height="{StaticResource Ilu.Size.ControllerDesignHeight}"
             Focusable="False" IsTabStop="False" IsHitTestVisible="False"
             AutomationProperties.Name="Controller drawing: Contour ShuttleXpress">
  <!-- DESIGN.md "Controller drawing", Contour ShuttleXpress (docs/design/controller-shuttlexpress.svg). Centre C = (160,100).
       Shuttle ring: outer r 48, inner r 36, 15 ticks built in code. Jog: r 32 with a dimple at radius 22. Buttons 1 to 5 on
       an arc of radius 64 about C at -60, -30, 0, +30, +60 degrees, each a 22 x 12 rounded rectangle rotated to it. -->
  <Canvas x:Name="Root" Width="320" Height="160">
    <Ellipse x:Name="Body" Canvas.Left="60" Canvas.Top="22" Width="200" Height="136"/>

    <Ellipse x:Name="Ring" Canvas.Left="112" Canvas.Top="52" Width="96" Height="96"/>
    <Ellipse x:Name="Ring_Inner" Canvas.Left="124" Canvas.Top="64" Width="72" Height="72"/>
    <Path x:Name="Ring_Arc" Visibility="Collapsed"/>
    <Line x:Name="Ring_Now" X1="160" X2="160" Y1="53" Y2="63" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Stroke="{StaticResource Ilu.Brush.TextStrong}" Visibility="Collapsed"/>

    <Ellipse x:Name="Jog" Canvas.Left="128" Canvas.Top="68" Width="64" Height="64"/>
    <Ellipse x:Name="Jog_Dimple" Canvas.Left="156" Canvas.Top="74" Width="8" Height="8"/>

    <Rectangle x:Name="Button1" Canvas.Left="93.6" Canvas.Top="62" Width="22" Height="12" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5">
      <Rectangle.RenderTransform><RotateTransform Angle="-60"/></Rectangle.RenderTransform>
    </Rectangle>
    <Rectangle x:Name="Button2" Canvas.Left="117" Canvas.Top="38.6" Width="22" Height="12" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5">
      <Rectangle.RenderTransform><RotateTransform Angle="-30"/></Rectangle.RenderTransform>
    </Rectangle>
    <Rectangle x:Name="Button3" Canvas.Left="149" Canvas.Top="30" Width="22" Height="12" RadiusX="4" RadiusY="4"/>
    <Rectangle x:Name="Button4" Canvas.Left="181" Canvas.Top="38.6" Width="22" Height="12" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5">
      <Rectangle.RenderTransform><RotateTransform Angle="30"/></Rectangle.RenderTransform>
    </Rectangle>
    <Rectangle x:Name="Button5" Canvas.Left="204.4" Canvas.Top="62" Width="22" Height="12" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5">
      <Rectangle.RenderTransform><RotateTransform Angle="60"/></Rectangle.RenderTransform>
    </Rectangle>
  </Canvas>
</UserControl>
