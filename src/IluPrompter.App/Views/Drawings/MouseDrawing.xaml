<UserControl x:Class="IluPrompter.App.Views.Drawings.MouseDrawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource Ilu.Size.ControllerDesignWidth}" Height="{StaticResource Ilu.Size.ControllerDesignHeight}"
             Focusable="False" IsTabStop="False" IsHitTestVisible="False"
             AutomationProperties.Name="Controller drawing: mouse wheel">
  <!-- DESIGN.md "Controller drawing", Mouse wheel (docs/design/controller-mouse.svg). The mouse from above, cable end up, on
       the left; the wheel, enlarged, on the right. 320 x 160 design box; each part is named by its ControlId. Left and right
       buttons are yours, not the prompt's: inert, never lit. No ground of its own: it sits on the panel. -->
  <Canvas x:Name="Root" Width="320" Height="160">
    <Path x:Name="Body" Stroke="{StaticResource Ilu.Brush.LineStrong}" StrokeThickness="1.5" StrokeLineJoin="Round"
          Data="M 44 50 C 44 22 60 10 84 10 C 108 10 124 22 124 50 L 124 112 C 124 136 108 150 84 150 C 60 150 44 136 44 112 Z"/>
    <Path x:Name="Inert1" Stroke="{StaticResource Ilu.Brush.LineStrong}" StrokeThickness="1" Data="M 84 10 L 84 22 M 84 48 L 84 62"/>
    <Path x:Name="Inert2" Stroke="{StaticResource Ilu.Brush.LineStrong}" StrokeThickness="1" Data="M 44 62 C 60 68 108 68 124 62"/>

    <!-- The small wheel on the mouse: Middle (press; fill lights) and the edge of Wheel (stroke lights) -->
    <Rectangle x:Name="Middle" Canvas.Left="78" Canvas.Top="22" Width="12" Height="26" RadiusX="6" RadiusY="6"/>
    <!-- Side buttons on the thumb side: XButton2 (forward) above XButton1 (back) -->
    <Rectangle x:Name="XButton2" Canvas.Left="38" Canvas.Top="74" Width="8" Height="16" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="XButton1" Canvas.Left="38" Canvas.Top="94" Width="8" Height="16" RadiusX="3" RadiusY="3"/>

    <!-- Callout from the small wheel to the enlarged one -->
    <Path x:Name="Callout" Stroke="{StaticResource Ilu.Brush.LineStrong}" StrokeThickness="1" StrokeDashArray="2 3"
          Data="M 90 22 L 196 22 M 90 48 L 196 138"/>

    <!-- The enlarged wheel, x 196..236, y 20..140, with ten treads 12 apart clipped to it (the treads are built in code) -->
    <Rectangle x:Name="Wheel" Canvas.Left="196" Canvas.Top="20" Width="40" Height="120" RadiusX="20" RadiusY="20"/>
    <Canvas x:Name="TreadClip" Canvas.Left="196" Canvas.Top="20" Width="40" Height="120">
      <Canvas.Clip>
        <RectangleGeometry Rect="0,0,40,120" RadiusX="20" RadiusY="20"/>
      </Canvas.Clip>
      <Canvas x:Name="Treads">
        <Canvas.RenderTransform>
          <TranslateTransform x:Name="TreadShift" Y="0"/>
        </Canvas.RenderTransform>
      </Canvas>
    </Canvas>

    <!-- Chevrons: up = away from you, down = towards you; each lights for 400 ms after a notch that way -->
    <Path x:Name="Wheel_Up" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 206 13 L 216 5 L 226 13"/>
    <Path x:Name="Wheel_Down" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 206 147 L 216 155 L 226 147"/>
  </Canvas>
</UserControl>
