<UserControl x:Class="IluPrompter.App.Views.Drawings.ShuttleProDrawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource Ilu.Size.ControllerDesignWidth}" Height="{StaticResource Ilu.Size.ControllerDesignHeight}"
             Focusable="False" IsTabStop="False"
             AutomationProperties.Name="Controller drawing: Contour ShuttlePRO v2">
  <!-- DESIGN.md "Controller drawing", Contour ShuttlePRO v2 (docs/design/controller-shuttlepro.svg), drawn from the unit's product photo:
       a tall pear-shaped body (wide rounded top, a long palm rest below; the controls fill the top 65 %), four oval buttons on a gentle
       arc, five below them (the outer two lower, at the shoulders, angled), the shuttle ring around the jog wheel, a tall side button
       each side, and four long curved buttons below the ring (two a side, like brackets). Parts are named by where they sit (Pos_*);
       Logic/ShuttleProLayout.cs is the one table from the provider's button numbers to these. Centre C = (160,68).
       Ring: outer r 28, inner r 21.5. Jog: r 19, with three dimples (a triangle) that turn with it.
       Nothing in the drawing is focusable. Generated from the same numbers as the SVG. -->
  <Canvas x:Name="Root" Width="320" Height="160">
    <Path x:Name="Body" Data="M 160,3 C 196,3 212,15 212,50 C 212,80 208,102 205,122 C 202,144 188,157 160,157 C 132,157 118,144 115,122 C 112,102 108,80 108,50 C 108,15 124,3 160,3 Z"/>

    <Rectangle x:Name="Pos_TopRow1" Canvas.Left="127.5" Canvas.Top="16.5" Width="14" Height="9" RadiusX="4.5" RadiusY="4.5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-14"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="Pos_TopRow2" Canvas.Left="144.5" Canvas.Top="12.5" Width="14" Height="9" RadiusX="4.5" RadiusY="4.5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-4"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="Pos_TopRow3" Canvas.Left="161.5" Canvas.Top="12.5" Width="14" Height="9" RadiusX="4.5" RadiusY="4.5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="4"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="Pos_TopRow4" Canvas.Left="178.5" Canvas.Top="16.5" Width="14" Height="9" RadiusX="4.5" RadiusY="4.5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="14"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="Pos_SecondRow1" Canvas.Left="119.5" Canvas.Top="36.5" Width="14" Height="9" RadiusX="4.5" RadiusY="4.5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-40"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="Pos_SecondRow2" Canvas.Left="136" Canvas.Top="27" Width="14" Height="9" RadiusX="4.5" RadiusY="4.5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-8"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="Pos_SecondRow3" Canvas.Left="153" Canvas.Top="24.5" Width="14" Height="9" RadiusX="4.5" RadiusY="4.5"/>
    <Rectangle x:Name="Pos_SecondRow4" Canvas.Left="170" Canvas.Top="27" Width="14" Height="9" RadiusX="4.5" RadiusY="4.5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="8"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="Pos_SecondRow5" Canvas.Left="186.5" Canvas.Top="36.5" Width="14" Height="9" RadiusX="4.5" RadiusY="4.5" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="40"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle x:Name="Pos_SideLeft" Canvas.Left="114.5" Canvas.Top="53" Width="8" Height="24" RadiusX="4" RadiusY="4"/>
    <Rectangle x:Name="Pos_SideRight" Canvas.Left="197.5" Canvas.Top="53" Width="8" Height="24" RadiusX="4" RadiusY="4"/>
    <Path x:Name="Pos_CurveUpperLeft" Data="M 119.27,84.19 Q 127.81,94.86 144.6,102.21 A 3.5,3.5 0 0 0 147.4,95.79 Q 132.19,89.14 124.73,79.81 A 3.5,3.5 0 0 0 119.27,84.19 Z"/>
    <Path x:Name="Pos_CurveUpperRight" Data="M 195.27,79.81 Q 187.81,89.14 172.6,95.79 A 3.5,3.5 0 0 0 175.4,102.21 Q 192.19,94.86 200.73,84.19 A 3.5,3.5 0 0 0 195.27,79.81 Z"/>
    <Path x:Name="Pos_CurveLowerLeft" Data="M 112.6,90.97 Q 122.64,105.76 140.51,114.17 A 3.5,3.5 0 0 0 143.49,107.83 Q 127.36,100.24 118.4,87.03 A 3.5,3.5 0 0 0 112.6,90.97 Z"/>
    <Path x:Name="Pos_CurveLowerRight" Data="M 201.6,87.03 Q 192.64,100.24 176.51,107.83 A 3.5,3.5 0 0 0 179.49,114.17 Q 197.36,105.76 207.4,90.97 A 3.5,3.5 0 0 0 201.6,87.03 Z"/>

    <!-- Ring (ticks are built in code) -->
    <Ellipse x:Name="Ring" Canvas.Left="132" Canvas.Top="40" Width="56" Height="56"/>
    <Ellipse x:Name="Ring_Inner" Canvas.Left="138.5" Canvas.Top="46.5" Width="43" Height="43"/>
    <Path x:Name="Ring_Arc" Visibility="Collapsed"/>
    <Line x:Name="Ring_Now" X1="160" X2="160" Y1="40.8" Y2="45.2" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Stroke="{StaticResource Ilu.Brush.TextStrong}" Visibility="Collapsed" IsHitTestVisible="False"/>

    <!-- Jog: the disc and its three dimples (turned by Jog_Rotate) -->
    <Ellipse x:Name="Jog" Canvas.Left="141" Canvas.Top="49" Width="38" Height="38"/>
    <Canvas x:Name="Jog_Dimples" Canvas.Left="141" Canvas.Top="49" Width="38" Height="38" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
      <Canvas.RenderTransform><RotateTransform x:Name="Jog_Rotate" Angle="0"/></Canvas.RenderTransform>
      <Ellipse x:Name="Jog_Dimple1" Canvas.Left="7.25" Canvas.Top="8.43" Width="8.8" Height="8.8"/>
      <Ellipse x:Name="Jog_Dimple2" Canvas.Left="23.62" Canvas.Top="11.32" Width="8.8" Height="8.8"/>
      <Ellipse x:Name="Jog_Dimple3" Canvas.Left="12.93" Canvas.Top="24.05" Width="8.8" Height="8.8"/>
    </Canvas>
  </Canvas>
</UserControl>
