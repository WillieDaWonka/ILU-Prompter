<UserControl x:Class="IluPrompter.App.Views.Drawings.ShuttleProDrawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource Ilu.Size.ControllerDesignWidth}" Height="{StaticResource Ilu.Size.ControllerDesignHeight}"
             Focusable="False" IsTabStop="False" IsHitTestVisible="False"
             AutomationProperties.Name="Controller drawing: Contour ShuttlePRO v2">
  <!-- DESIGN.md "Controller drawing", Contour ShuttlePRO v2 (docs/design/controller-shuttlepro.svg). SCHEMATIC: the button
       positions follow the provider's numbering (left to right, top to bottom); check against the venue's unit (DESIGN.md
       open question 6). Centre C = (160,100). Ring: outer r 40, inner r 30. Jog: r 26, dimple at radius 17. -->
  <Canvas x:Name="Root" Width="320" Height="160">
    <Rectangle x:Name="Body" Canvas.Left="84" Canvas.Top="4" Width="152" Height="152" RadiusX="24" RadiusY="24"/>

    <!-- Row 1 -->
    <Rectangle x:Name="Button1" Canvas.Left="115" Canvas.Top="13" Width="18" Height="10" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button2" Canvas.Left="139" Canvas.Top="13" Width="18" Height="10" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button3" Canvas.Left="163" Canvas.Top="13" Width="18" Height="10" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button4" Canvas.Left="187" Canvas.Top="13" Width="18" Height="10" RadiusX="3" RadiusY="3"/>
    <!-- Row 2 -->
    <Rectangle x:Name="Button5" Canvas.Left="103" Canvas.Top="31" Width="18" Height="10" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button6" Canvas.Left="127" Canvas.Top="31" Width="18" Height="10" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button7" Canvas.Left="151" Canvas.Top="31" Width="18" Height="10" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button8" Canvas.Left="175" Canvas.Top="31" Width="18" Height="10" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button9" Canvas.Left="199" Canvas.Top="31" Width="18" Height="10" RadiusX="3" RadiusY="3"/>

    <!-- Ring (ticks are built in code) -->
    <Ellipse x:Name="Ring" Canvas.Left="120" Canvas.Top="60" Width="80" Height="80"/>
    <Ellipse x:Name="Ring_Inner" Canvas.Left="130" Canvas.Top="70" Width="60" Height="60"/>
    <Path x:Name="Ring_Arc" Visibility="Collapsed"/>
    <Line x:Name="Ring_Now" X1="160" X2="160" Y1="61" Y2="69" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Stroke="{StaticResource Ilu.Brush.TextStrong}" Visibility="Collapsed"/>

    <!-- Jog -->
    <Ellipse x:Name="Jog" Canvas.Left="134" Canvas.Top="74" Width="52" Height="52"/>
    <Ellipse x:Name="Jog_Dimple" Canvas.Left="156.5" Canvas.Top="79.5" Width="7" Height="7"/>

    <!-- Side buttons -->
    <Rectangle x:Name="Button10" Canvas.Left="94" Canvas.Top="68" Width="16" Height="16" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button11" Canvas.Left="210" Canvas.Top="68" Width="16" Height="16" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button12" Canvas.Left="94" Canvas.Top="94" Width="16" Height="16" RadiusX="3" RadiusY="3"/>
    <Rectangle x:Name="Button13" Canvas.Left="210" Canvas.Top="94" Width="16" Height="16" RadiusX="3" RadiusY="3"/>
    <!-- Thumb buttons -->
    <Rectangle x:Name="Button14" Canvas.Left="92" Canvas.Top="129" Width="24" Height="14" RadiusX="5" RadiusY="5"/>
    <Rectangle x:Name="Button15" Canvas.Left="204" Canvas.Top="129" Width="24" Height="14" RadiusX="5" RadiusY="5"/>
  </Canvas>
</UserControl>
