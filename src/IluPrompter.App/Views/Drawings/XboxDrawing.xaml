<UserControl x:Class="IluPrompter.App.Views.Drawings.XboxDrawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource Ilu.Size.ControllerDesignWidth}" Height="{StaticResource Ilu.Size.ControllerDesignHeight}"
             Focusable="False" IsTabStop="False" IsHitTestVisible="False"
             AutomationProperties.Name="Controller drawing: Xbox controller">
  <!-- DESIGN.md "Controller drawing", Xbox controller (docs/design/controller-xbox.svg). 320 x 160 design box; each part is
       named by its ControlId. Moving parts: Name.Fill (trigger meter), Name.Dot (stick). The A, B, X and Y letters are
       the only text, in the large drawing only (text never shrinks below 13 DIP). -->
  <Canvas x:Name="Root" Width="320" Height="160">
    <Path x:Name="Body" Stroke="{StaticResource Ilu.Brush.LineStrong}" StrokeThickness="1.5" StrokeLineJoin="Round"
          Data="M 96 28 C 124 20 196 20 224 28 C 262 36 290 70 300 118 C 306 146 286 158 266 148 C 252 140 242 122 224 112 L 96 112 C 78 122 68 140 54 148 C 34 158 14 146 20 118 C 30 70 58 36 96 28 Z"/>

    <!-- Triggers: vertical meters 12 x 60, filled from the bottom by the pull; a deadzone tick across each -->
    <Rectangle x:Name="LeftTrigger" Canvas.Left="22" Canvas.Top="4" Width="12" Height="60" RadiusX="2" RadiusY="2"/>
    <Rectangle x:Name="LeftTrigger_Fill" Canvas.Left="22" Canvas.Top="64" Width="12" Height="0" RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
    <Line x:Name="LeftTrigger_Tick" X1="18" X2="38" Y1="56.8" Y2="56.8" StrokeThickness="1"/>
    <Rectangle x:Name="RightTrigger" Canvas.Left="286" Canvas.Top="4" Width="12" Height="60" RadiusX="2" RadiusY="2"/>
    <Rectangle x:Name="RightTrigger_Fill" Canvas.Left="286" Canvas.Top="64" Width="12" Height="0" RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
    <Line x:Name="RightTrigger_Tick" X1="282" X2="302" Y1="56.8" Y2="56.8" StrokeThickness="1"/>

    <!-- Bumpers -->
    <Rectangle x:Name="LeftShoulder" Canvas.Left="60" Canvas.Top="10" Width="60" Height="10" RadiusX="5" RadiusY="5"/>
    <Rectangle x:Name="RightShoulder" Canvas.Left="200" Canvas.Top="10" Width="60" Height="10" RadiusX="5" RadiusY="5"/>

    <!-- Guide: not an XInput input, drawn inert -->
    <Ellipse x:Name="Guide" Canvas.Left="152" Canvas.Top="28" Width="16" Height="16" Stroke="{StaticResource Ilu.Brush.LineStrong}" StrokeThickness="1"/>

    <!-- View (Back) and Menu (Start) -->
    <Rectangle x:Name="Back" Canvas.Left="138" Canvas.Top="50" Width="12" Height="8" RadiusX="4" RadiusY="4"/>
    <Rectangle x:Name="Start" Canvas.Left="170" Canvas.Top="50" Width="12" Height="8" RadiusX="4" RadiusY="4"/>

    <!-- Left stick: ring r 18 at (92,58); dashed deadzone ring; dot r 5 travelling 13 -->
    <Ellipse x:Name="LeftThumb" Canvas.Left="74" Canvas.Top="40" Width="36" Height="36"/>
    <Ellipse x:Name="LeftThumb_Dz" Canvas.Left="87.7" Canvas.Top="53.7" Width="8.6" Height="8.6" StrokeThickness="1" StrokeDashArray="2 2"
             Stroke="{StaticResource Ilu.Brush.LineStrong}"/>
    <Ellipse x:Name="LeftThumb_Dot" Canvas.Left="87" Canvas.Top="53" Width="10" Height="10"/>

    <!-- D-pad: four arms, each its own control; the centre square is inert -->
    <Rectangle x:Name="DPadUp" Canvas.Left="119" Canvas.Top="74" Width="10" Height="11" RadiusX="1.5" RadiusY="1.5"/>
    <Rectangle x:Name="DPadDown" Canvas.Left="119" Canvas.Top="95" Width="10" Height="11" RadiusX="1.5" RadiusY="1.5"/>
    <Rectangle x:Name="DPadLeft" Canvas.Left="108" Canvas.Top="85" Width="11" Height="10" RadiusX="1.5" RadiusY="1.5"/>
    <Rectangle x:Name="DPadRight" Canvas.Left="129" Canvas.Top="85" Width="11" Height="10" RadiusX="1.5" RadiusY="1.5"/>
    <Rectangle x:Name="DPadCentre" Canvas.Left="119" Canvas.Top="85" Width="10" Height="10" Stroke="{StaticResource Ilu.Brush.LineStrong}" StrokeThickness="1"/>

    <!-- Right stick: ring r 18 at (196,90) -->
    <Ellipse x:Name="RightThumb" Canvas.Left="178" Canvas.Top="72" Width="36" Height="36"/>
    <Ellipse x:Name="RightThumb_Dz" Canvas.Left="191.2" Canvas.Top="85.2" Width="9.6" Height="9.6" StrokeThickness="1" StrokeDashArray="2 2"
             Stroke="{StaticResource Ilu.Brush.LineStrong}"/>
    <Ellipse x:Name="RightThumb_Dot" Canvas.Left="191" Canvas.Top="85" Width="10" Height="10"/>

    <!-- Face buttons around (230,56), r 9: Y top, X left, B right, A bottom -->
    <Ellipse x:Name="Y" Canvas.Left="221" Canvas.Top="31" Width="18" Height="18"/>
    <Ellipse x:Name="X" Canvas.Left="205" Canvas.Top="47" Width="18" Height="18"/>
    <Ellipse x:Name="B" Canvas.Left="237" Canvas.Top="47" Width="18" Height="18"/>
    <Ellipse x:Name="A" Canvas.Left="221" Canvas.Top="63" Width="18" Height="18"/>
    <TextBlock x:Name="Letter_Y" Canvas.Left="221" Canvas.Top="31" Width="18" Height="18" Text="Y" TextAlignment="Center" Style="{StaticResource Ilu.Text.Label}"/>
    <TextBlock x:Name="Letter_X" Canvas.Left="205" Canvas.Top="47" Width="18" Height="18" Text="X" TextAlignment="Center" Style="{StaticResource Ilu.Text.Label}"/>
    <TextBlock x:Name="Letter_B" Canvas.Left="237" Canvas.Top="47" Width="18" Height="18" Text="B" TextAlignment="Center" Style="{StaticResource Ilu.Text.Label}"/>
    <TextBlock x:Name="Letter_A" Canvas.Left="221" Canvas.Top="63" Width="18" Height="18" Text="A" TextAlignment="Center" Style="{StaticResource Ilu.Text.Label}"/>
  </Canvas>
</UserControl>
