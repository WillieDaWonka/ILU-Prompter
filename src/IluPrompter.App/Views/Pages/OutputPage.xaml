<UserControl x:Class="IluPrompter.App.Views.Pages.OutputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IluPrompter.App.Controls"
             xmlns:v="clr-namespace:IluPrompter.App.Views"
             Focusable="False" IsTabStop="False">
  <!-- Settings > Output. DataContext: OutputPageViewModel. All output layout in one place (DESIGN.md D7). -->
  <StackPanel MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Text="Display" Style="{StaticResource Ilu.Text.Heading}" Margin="0,0,0,6"/>
    <ComboBox Width="440" HorizontalAlignment="Left" ItemsSource="{Binding Displays}" SelectedValuePath="Id"
              SelectedValue="{Binding SelectedDisplayId, Mode=TwoWay}" AutomationProperties.Name="Output display">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Ilu.Text.Body}" TextWrapping="NoWrap"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    <TextBlock Text="{Binding DisplayHint}" Style="{StaticResource Ilu.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>

    <TextBlock Text="Margins" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,2"/>
    <TextBlock Style="{StaticResource Ilu.Text.Caption}" Margin="0,0,0,10" TextWrapping="Wrap"
               Text="In pixels of the output display. They stay in proportion if the resolution changes."/>
    <Border Background="{StaticResource Ilu.Brush.Surface}" BorderBrush="{StaticResource Ilu.Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Ilu.Radius.Panel}" Padding="16" HorizontalAlignment="Left">
      <v:MarginEditor DataContext="{Binding Layout.Margins}"/>
    </Border>

    <TextBlock Text="Lines" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <StackPanel Orientation="Horizontal">
      <StackPanel Margin="0,0,32,0">
        <TextBlock Text="Lines visible" Style="{StaticResource Ilu.Text.Label}" Margin="0,0,0,4"/>
        <c:NumberBox HorizontalAlignment="Left" Value="{Binding Layout.LinesVisible, Mode=TwoWay}" Minimum="4" Maximum="16" Step="1" ShiftStep="1"
                     AutomationProperties.Name="Lines visible"/>
      </StackPanel>
      <StackPanel Margin="0,0,32,0">
        <TextBlock Text="Line spacing" Style="{StaticResource Ilu.Text.Label}" Margin="0,0,0,4"/>
        <c:NumberBox HorizontalAlignment="Left" Value="{Binding Layout.LineSpacing, Mode=TwoWay}" Minimum="1" Maximum="2" Step="0.05" ShiftStep="0.05"
                     Decimals="2" AutomationProperties.Name="Line spacing"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Reading line" Style="{StaticResource Ilu.Text.Label}" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal">
          <c:NumberBox Value="{Binding Layout.ReadingLinePercent, Mode=TwoWay}" Minimum="10" Maximum="60" Step="1" ShiftStep="5"
                       AutomationProperties.Name="Reading line position in percent"/>
          <TextBlock Text="%" Style="{StaticResource Ilu.Text.Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <TextBlock Style="{StaticResource Ilu.Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
               Text="Lines visible sets the text size, so it looks the same on any display. The reading line is how far down the text area it sits."/>

    <TextBlock Text="On the output" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <CheckBox Content="Show the reading-line marker" IsChecked="{Binding Layout.ShowReadingMarker, Mode=TwoWay}"/>
    <CheckBox Content="Dim lines above the reading line" IsChecked="{Binding Layout.DimAboveReadingLine, Mode=TwoWay}"/>
    <CheckBox Content="Show section names on the output" IsChecked="{Binding Layout.ShowSectionNames, Mode=TwoWay}"/>
  </StackPanel>
</UserControl>
