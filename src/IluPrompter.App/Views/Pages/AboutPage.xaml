<UserControl x:Class="IluPrompter.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False">
  <!-- Settings > About: the ILUMINA logo, version, licences. DataContext: AboutPageViewModel. -->
  <StackPanel MaxWidth="560" HorizontalAlignment="Left">
    <Border Background="{StaticResource Ilu.Brush.Surface}" BorderBrush="{StaticResource Ilu.Brush.Line}" BorderThickness="1"
            CornerRadius="{StaticResource Ilu.Radius.Panel}" Padding="32,28" HorizontalAlignment="Left">
      <Image Source="{Binding LogoUri}" Width="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ILUMINA"/>
    </Border>
    <TextBlock Text="ILU Prompter" Style="{StaticResource Ilu.Text.Title}" Margin="0,24,0,0"/>
    <TextBlock Text="{Binding Version}" Style="{StaticResource Ilu.Text.Mono}" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding Tagline}" Style="{StaticResource Ilu.Text.Body}" Margin="0,8,0,0"/>

    <TextBlock Text="Licences" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <ItemsControl ItemsSource="{Binding Licences}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" Style="{StaticResource Ilu.Text.Body}" Margin="0,0,0,4"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
