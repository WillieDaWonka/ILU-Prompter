<UserControl x:Class="IluPrompter.App.Views.Pages.ShortcutsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IluPrompter.App.Logic"
             Focusable="False" IsTabStop="False">
  <!-- Settings > Shortcuts: the keyboard map, read-only. DataContext: ShortcutsPageViewModel. -->
  <StackPanel MaxWidth="600" HorizontalAlignment="Left">
    <TextBlock Style="{StaticResource Ilu.Text.Body}" Foreground="{StaticResource Ilu.Brush.TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"
               Text="Two key modes, always shown in the status bar. When the caret is in the script, keys type. Esc hands them to the transport."/>
    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:ShortcutGroup}">
          <StackPanel Margin="0,16,0,0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Ilu.Text.Heading}"/>
            <TextBlock Text="{Binding Caption}" Style="{StaticResource Ilu.Text.Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <Border Background="{StaticResource Ilu.Brush.Surface}" BorderBrush="{StaticResource Ilu.Brush.Line}" BorderThickness="1"
                    CornerRadius="{StaticResource Ilu.Radius.Panel}" Padding="4">
              <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ShortcutEntry}">
                    <Grid MinHeight="30">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Keys}" Style="{StaticResource Ilu.Text.Mono}" FontSize="13" Margin="10,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource Ilu.Brush.TextStrong}"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="{Binding Action}" Style="{StaticResource Ilu.Text.Body}"/>
                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Ilu.Text.Caption}">
                              <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding ClickerNote}" Style="{StaticResource Ilu.Text.Caption}" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <Button Content="Print this list" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,0" Click="OnPrint"/>
  </StackPanel>
</UserControl>
