<UserControl x:Class="IluPrompter.App.Views.Pages.ScrollingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IluPrompter.App.Controls"
             Focusable="False" IsTabStop="False">
  <!-- Settings > Scrolling. DataContext: ScrollingPageViewModel. -->
  <StackPanel MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Text="Default mode" Style="{StaticResource Ilu.Text.Heading}" Margin="0,0,0,6"/>
    <Border Background="{StaticResource Ilu.Brush.Canvas}" BorderBrush="{StaticResource Ilu.Brush.LineStrong}" BorderThickness="1"
            CornerRadius="{StaticResource Ilu.Radius.Control}" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <RadioButton Style="{StaticResource Ilu.RadioButton.Segment}" GroupName="DefaultMode" Content="Display scrolling" IsChecked="{Binding DefaultIsDisplay, Mode=TwoWay}"
                     ToolTip="Smooth, at the set speed" Height="34"/>
        <Border Width="1" Background="{StaticResource Ilu.Brush.LineStrong}"/>
        <RadioButton Style="{StaticResource Ilu.RadioButton.Segment}" GroupName="DefaultMode" Content="Line scrolling" IsChecked="{Binding DefaultIsLine, Mode=TwoWay}"
                     ToolTip="One line per step" Height="34"/>
      </StackPanel>
    </Border>

    <TextBlock Text="Speed" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <StackPanel Orientation="Horizontal">
      <StackPanel Margin="0,0,32,0">
        <TextBlock Text="Start speed" Style="{StaticResource Ilu.Text.Label}" Margin="0,0,0,4"/>
        <c:NumberBox HorizontalAlignment="Left" Value="{Binding StartSpeed, Mode=TwoWay}" Minimum="0.5" Maximum="10" Step="0.5" ShiftStep="0.1" Decimals="1"
                     AutomationProperties.Name="Start speed"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Speed step" Style="{StaticResource Ilu.Text.Label}" Margin="0,0,0,4"/>
        <c:NumberBox HorizontalAlignment="Left" Value="{Binding SpeedStep, Mode=TwoWay}" Minimum="0.1" Maximum="2" Step="0.1" ShiftStep="0.5" Decimals="1"
                     AutomationProperties.Name="Speed step"/>
      </StackPanel>
    </StackPanel>
    <TextBlock Style="{StaticResource Ilu.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
               Text="The − and + buttons and the Up and Down keys change the speed by the step. Shift changes it by 0.1."/>

    <TextBlock Text="Acceleration" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <StackPanel Orientation="Horizontal">
      <RadioButton Style="{StaticResource Ilu.RadioButton}" GroupName="Acceleration" Content="Gentle" IsChecked="{Binding IsGentle, Mode=TwoWay}" Margin="0,0,24,0"/>
      <RadioButton Style="{StaticResource Ilu.RadioButton}" GroupName="Acceleration" Content="Normal" IsChecked="{Binding IsNormal, Mode=TwoWay}" Margin="0,0,24,0"/>
      <RadioButton Style="{StaticResource Ilu.RadioButton}" GroupName="Acceleration" Content="Quick" IsChecked="{Binding IsQuick, Mode=TwoWay}"/>
    </StackPanel>
    <TextBlock Style="{StaticResource Ilu.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
               Text="How fast the prompt settles when you change speed while it is moving."/>

    <TextBlock Text="Sections" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <CheckBox Content="Pause at section markers" IsChecked="{Binding PauseAtSections, Mode=TwoWay}"/>
  </StackPanel>
</UserControl>
