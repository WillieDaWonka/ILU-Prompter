<UserControl x:Class="IluPrompter.App.Views.Pages.TextPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IluPrompter.App.Controls"
             xmlns:vm="clr-namespace:IluPrompter.App.ViewModels"
             Focusable="False" IsTabStop="False">
  <!-- Settings > Text. DataContext: TextPageViewModel. -->
  <StackPanel MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock Text="Output face" Style="{StaticResource Ilu.Text.Heading}" Margin="0,0,0,6"/>
    <ComboBox Width="300" HorizontalAlignment="Left" ItemsSource="{Binding Faces}" SelectedItem="{Binding SelectedFace, Mode=TwoWay}"
              AutomationProperties.Name="Output face">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock x:Name="Label" Text="{Binding}" Style="{StaticResource Ilu.Text.Body}" TextWrapping="NoWrap"/>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="Other">
              <Setter TargetName="Label" Property="Text" Value="Other installed font…"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Style="{StaticResource Ilu.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
               Text="Poppins is the house face. Segoe UI is narrower. Bahnschrift fits about 15 % more words on a line."/>

    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsOtherFace, Converter={x:Static c:BoolToVisibilityConverter.Instance}}">
      <ComboBox Width="300" HorizontalAlignment="Left" ItemsSource="{Binding InstalledFamilies}" SelectedItem="{Binding OtherFamily, Mode=TwoWay}"
                AutomationProperties.Name="Installed font"/>
      <TextBlock Text="{Binding OtherWarning}" Style="{StaticResource Ilu.Text.Caption}" Foreground="{StaticResource Ilu.Brush.Attention}" Margin="0,6,0,0"/>
    </StackPanel>

    <TextBlock Text="Weight" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <StackPanel Orientation="Horizontal">
      <RadioButton Style="{StaticResource Ilu.RadioButton}" GroupName="Weight" Content="Regular" IsChecked="{Binding IsRegularWeight, Mode=TwoWay}" Margin="0,0,24,0"/>
      <RadioButton Style="{StaticResource Ilu.RadioButton}" GroupName="Weight" Content="Medium (easier to read at a distance)" IsChecked="{Binding IsMediumWeight, Mode=TwoWay}"/>
    </StackPanel>

    <TextBlock Text="Default ink" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <ComboBox Width="300" HorizontalAlignment="Left" ItemsSource="{Binding Inks}" SelectedValuePath="Token" SelectedValue="{Binding DefaultInk, Mode=TwoWay}"
              AutomationProperties.Name="Default ink">
      <ComboBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:InkChoice}">
          <StackPanel Orientation="Horizontal">
            <Border Width="20" Height="20" Background="{Binding Swatch}" BorderBrush="{StaticResource Ilu.Brush.LineStrong}" BorderThickness="1" CornerRadius="2"/>
            <TextBlock Text="{Binding Name}" Style="{StaticResource Ilu.Text.Body}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Style="{StaticResource Ilu.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
               Text="Used for any text without its own colour. The eight script colours are in the editor toolbar."/>

    <TextBlock Text="Alignment" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <StackPanel Orientation="Horizontal">
      <RadioButton Style="{StaticResource Ilu.RadioButton}" GroupName="Alignment" Content="Left" IsChecked="{Binding IsAlignedLeft, Mode=TwoWay}" Margin="0,0,24,0"/>
      <RadioButton Style="{StaticResource Ilu.RadioButton}" GroupName="Alignment" Content="Centre" IsChecked="{Binding IsAlignedCentre, Mode=TwoWay}"/>
    </StackPanel>

    <TextBlock Text="Editor zoom" Style="{StaticResource Ilu.Text.Heading}" Margin="0,24,0,6"/>
    <StackPanel Orientation="Horizontal">
      <c:NumberBox Value="{Binding EditorZoom, Mode=TwoWay}" Minimum="70" Maximum="200" Step="5" ShiftStep="25" AutomationProperties.Name="Editor zoom in percent"/>
      <TextBlock Text="%" Style="{StaticResource Ilu.Text.Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
    </StackPanel>
    <TextBlock Style="{StaticResource Ilu.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
               Text="Only the editor changes size. The output is unaffected."/>
  </StackPanel>
</UserControl>
