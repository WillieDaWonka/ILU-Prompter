<UserControl x:Class="IluPrompter.App.Views.ChipsRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False">
  <!-- DESIGN.md "State chip": a filled chip, glyph + subject + "·" + state word in capitals. One chip, one subject.
       Click opens the matching Settings page. DataContext: LiveViewModel. -->
  <UserControl.Resources>
    <DataTemplate x:Key="ChipContent">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Ilu.Text.Glyph}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock Text="{Binding Subject}" Style="{StaticResource Ilu.Text.Label}" VerticalAlignment="Center"/>
        <TextBlock Text=" &#x00B7; " Style="{StaticResource Ilu.Text.Label}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding State}" Style="{StaticResource Ilu.Text.State}" FontSize="13" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel Orientation="Horizontal">
    <Button Style="{StaticResource Ilu.Button.Chip}" Tag="{Binding OutputChip.StyleTag}" ToolTip="{Binding OutputChip.Tooltip}"
            AutomationProperties.Name="{Binding OutputChip.Automation}"
            Command="{Binding ChipClickedCommand}" CommandParameter="output"
            Content="{Binding OutputChip}" ContentTemplate="{StaticResource ChipContent}"/>
    <Button Style="{StaticResource Ilu.Button.Chip}" Margin="8,0,0,0" Tag="{Binding ControllerChip.StyleTag}" ToolTip="{Binding ControllerChip.Tooltip}"
            AutomationProperties.Name="{Binding ControllerChip.Automation}"
            Command="{Binding ChipClickedCommand}" CommandParameter="controller"
            Content="{Binding ControllerChip}" ContentTemplate="{StaticResource ChipContent}"/>
  </StackPanel>
</UserControl>
