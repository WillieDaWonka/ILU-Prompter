<Window x:Class="IluPrompter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IluPrompter.App.ViewModels"
        xmlns:p="clr-namespace:IluPrompter.App.Views.Pages"
        xmlns:c="clr-namespace:IluPrompter.App.Controls"
        xmlns:interop="clr-namespace:IluPrompter.App.Interop"
        Style="{StaticResource Ilu.Window}" interop:DarkTitleBar.IsEnabled="True"
        Title="Settings" Width="820" Height="640" MinWidth="720" MinHeight="560"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" PreviewKeyDown="OnPreviewKeyDown">
  <!-- DESIGN.md "Settings window": non-modal and owned, so you can change layout while watching the preview. Dark title bar,
       canvas ground, navigation on surface (200 px, rows 32 px). Changes apply as you make them: no OK, no Apply.
       DataContext: SettingsViewModel. -->
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:ControllerPageViewModel}"><p:ControllerPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:OutputPageViewModel}"><p:OutputPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TextPageViewModel}"><p:TextPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ScrollingPageViewModel}"><p:ScrollingPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ShortcutsPageViewModel}"><p:ShortcutsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutPageViewModel}"><p:AboutPage/></DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Background="{StaticResource Ilu.Brush.Surface}" BorderBrush="{StaticResource Ilu.Brush.Line}" BorderThickness="0,0,1,0">
      <ListBox Style="{StaticResource Ilu.ListBox}" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
               ItemContainerStyle="{StaticResource Ilu.ListBoxItem.Nav}" Margin="0,12,0,0" AutomationProperties.Name="Settings pages">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:SettingsPageItem}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Ilu.Text.Body}" TextWrapping="NoWrap"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource Ilu.Text.Title}" Margin="32,24,32,8"/>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ContentControl Content="{Binding SelectedPage.Page}" Margin="32,8,20,24" IsTabStop="False" Focusable="False"/>
      </ScrollViewer>

      <Border Grid.Row="2" BorderBrush="{StaticResource Ilu.Brush.Line}" BorderThickness="0,1,0,0" Padding="32,12">
        <Grid>
          <Button Style="{StaticResource Ilu.Button.Link}" Content="Reset this page to defaults" Command="{Binding ResetPageCommand}"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Visibility="{Binding CanResetPage, Converter={x:Static c:BoolToVisibilityConverter.Instance}}"/>
          <Button Content="Close" HorizontalAlignment="Right" Click="OnClose" ToolTip="Close settings (Esc)"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
