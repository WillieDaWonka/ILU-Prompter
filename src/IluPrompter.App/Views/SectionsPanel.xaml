<UserControl x:Class="IluPrompter.App.Views.SectionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IluPrompter.App.ViewModels"
             xmlns:c="clr-namespace:IluPrompter.App.Controls"
             xmlns:t="clr-namespace:IluPrompter.Theme;assembly=IluPrompter.Theme"
             Focusable="False" IsTabStop="False">
  <!-- DESIGN.md "Section list (B)". Click shows the section in the editor; double-click or Enter jumps the prompt
       there (a cut, then paused); right-click renames or deletes the marker. DataContext: SectionsViewModel. -->
  <Border Style="{StaticResource Ilu.Panel}" Padding="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="{StaticResource Ilu.Grid.PanelTitleBar}"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="12,0,6,0">
        <TextBlock Text="Sections" Style="{StaticResource Ilu.Text.Heading}" VerticalAlignment="Center"/>
        <Button x:Name="AddIcon" Style="{StaticResource Ilu.Button.Toolbar}" HorizontalAlignment="Right" VerticalAlignment="Center"
                ToolTip="Insert section marker (Ctrl+Shift+Enter)" AutomationProperties.Name="Insert section marker"
                AutomationProperties.AcceleratorKey="Ctrl+Shift+Enter" Click="OnAdd">
          <TextBlock Text="&#xE710;" Style="{StaticResource Ilu.Text.Icon}"/>
        </Button>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource Ilu.Divider}" VerticalAlignment="Top"/>

      <ListBox x:Name="List" Grid.Row="1" Margin="8,8,4,8" Style="{StaticResource Ilu.ListBox}" ItemsSource="{Binding Rows}"
               SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnListKeyDown"
               PreviewMouseRightButtonDown="OnListRightClick" ContextMenuOpening="OnContextMenuOpening"
               AutomationProperties.Name="Sections">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Rename" Click="OnRename"/>
            <MenuItem Header="Delete marker" Click="OnDelete"/>
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource Ilu.ListBoxItem.Section}">
            <Setter Property="Tag" Value="{Binding CurrentTag}"/>
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:SectionRowViewModel}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Mark" Text="&#x25B6;" Style="{StaticResource Ilu.Text.Glyph}" FontSize="10" VerticalAlignment="Top" Margin="0,3,0,0"
                         Visibility="Hidden"/>
              <StackPanel Grid.Column="1">
                <TextBlock TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Style="{StaticResource Ilu.Text.Label}">
                  <Run Text="{Binding Number, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Name, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding DurationText}" Style="{StaticResource Ilu.Text.Mono}" Foreground="{StaticResource Ilu.Brush.TextMuted}"
                           Visibility="{Binding HasDuration, Converter={x:Static c:BoolToVisibilityConverter.Instance}}"/>
              </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="1" Margin="16,12,16,0" VerticalAlignment="Top" Style="{StaticResource Ilu.Text.Caption}" TextWrapping="Wrap"
                 Text="{Binding EmptyText}" Visibility="{Binding IsEmpty, Converter={x:Static c:BoolToVisibilityConverter.Instance}}"/>

      <Button x:Name="AddButton" Grid.Row="2" Margin="8" Content="Add section" Click="OnAdd"
              ToolTip="Insert a section marker at the caret (Ctrl+Shift+Enter)"/>
    </Grid>
  </Border>
</UserControl>
