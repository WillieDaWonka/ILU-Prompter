<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- DESIGN.md "Elevation": flat. Panels, scroll bars, list rows (sections, settings navigation), windows. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/IluPrompter.Theme;component/Themes/IluTokens.xaml"/>
    <ResourceDictionary Source="/IluPrompter.Theme;component/Themes/IluButtons.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Window and dialog ground (set Style="{StaticResource Ilu.Window}" on every window) -->
  <Style x:Key="Ilu.Window" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Ilu.Brush.Canvas}"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>

  <!-- Panel: surface, 1 px line, radius 3, padding 12 -->
  <Style x:Key="Ilu.Panel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Ilu.Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ilu.Brush.Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Ilu.Radius.Panel}"/>
    <Setter Property="Padding" Value="{StaticResource Ilu.Pad.Panel}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- 1 px divider -->
  <Style x:Key="Ilu.Divider" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Ilu.Brush.Line}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- ===== Scroll bars: slim, dark, no arrow buttons ===== -->
  <Style x:Key="Ilu.ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Th" Background="{StaticResource Ilu.Brush.Idle}" CornerRadius="3" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Th" Property="Background" Value="{StaticResource Ilu.Brush.LineStrong}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Th" Property="Background" Value="{StaticResource Ilu.Brush.TextMuted}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Ilu.ScrollBar.Page" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="Ilu.ScrollBar.Vertical" TargetType="ScrollBar">
    <Border Background="Transparent" Width="12">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Ilu.ScrollBar.Page}"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Ilu.ScrollBar.Page}"/>
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource Ilu.ScrollBar.Thumb}"/>
        </Track.Thumb>
      </Track>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="Ilu.ScrollBar.Horizontal" TargetType="ScrollBar">
    <Border Background="Transparent" Height="12">
      <Track x:Name="PART_Track">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Ilu.ScrollBar.Page}"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Ilu.ScrollBar.Page}"/>
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource Ilu.ScrollBar.Thumb}"/>
        </Track.Thumb>
      </Track>
    </Border>
  </ControlTemplate>

  <Style x:Key="Ilu.ScrollBar" TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template" Value="{StaticResource Ilu.ScrollBar.Vertical}"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Template" Value="{StaticResource Ilu.ScrollBar.Horizontal}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource Ilu.ScrollBar}"/>

  <!-- ===== ListBox: transparent, no border ===== -->
  <Style x:Key="Ilu.ListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Section row: 32 px (grows with a second line), radius 4. Selected = selection (shown in the editor).
       Tag = "current" marks the CURRENT section (at the reading line): raised fill, 3 px text-strong left bar. -->
  <Style x:Key="Ilu.ListBoxItem.Section" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="MinHeight" Value="{StaticResource Ilu.Size.ListRow}"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual.Small}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Ilu.Radius.Control}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-10,-4,0,-4" Background="{StaticResource Ilu.Brush.TextStrong}"
                      Visibility="Collapsed" CornerRadius="1.5"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Selection}"/>
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.TextStrong}"/>
            </Trigger>
            <Trigger Property="Tag" Value="current">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.TextStrong}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Tag" Value="current"/>
                <Condition Property="IsSelected" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Selection}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Settings navigation row: 32 px, selected = raised with a 3 px text-strong left bar -->
  <Style x:Key="Ilu.ListBoxItem.Nav" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="MinHeight" Value="{StaticResource Ilu.Size.ListRow}"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual.Small}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-16,0,0,0"
                      Background="{StaticResource Ilu.Brush.TextStrong}" Visibility="Collapsed"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.TextStrong}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Plain read-only table rows (mapping table, shortcuts): no selection chrome -->
  <Style x:Key="Ilu.ListBoxItem.Plain" TargetType="ListBoxItem">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
