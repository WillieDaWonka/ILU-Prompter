<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- DESIGN.md "Components" and "States": push buttons, transport, Play, toolbar, segmented switch, Blank toggle.
       No motion: every state change is instant. Focus: a 2 px ring outside the control (keyboard only; WPF
       FocusVisualStyle never draws for mouse focus). On action and live fills a 2 px gap sits inside the ring. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/IluPrompter.Theme;component/Themes/IluTokens.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="Ilu.FocusVisual" TargetType="{x:Type Control}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Control}">
          <Rectangle Margin="-2" StrokeThickness="2" RadiusX="7" RadiusY="7" Stroke="{StaticResource Ilu.Brush.Focus}"
                     SnapsToDevicePixels="True" IsHitTestVisible="False"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Ilu.FocusVisual.Gap" TargetType="{x:Type Control}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Control}">
          <Rectangle Margin="-4" StrokeThickness="2" RadiusX="9" RadiusY="9" Stroke="{StaticResource Ilu.Brush.Focus}"
                     SnapsToDevicePixels="True" IsHitTestVisible="False"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Ilu.FocusVisual.Small" TargetType="{x:Type Control}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Control}">
          <Rectangle Margin="-2" StrokeThickness="2" RadiusX="5" RadiusY="5" Stroke="{StaticResource Ilu.Brush.Focus}"
                     SnapsToDevicePixels="True" IsHitTestVisible="False"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Secondary (default push button): transparent, line-strong edge, radius 6, 44 tall ===== -->
  <Style x:Key="Ilu.Button.Secondary" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ilu.Brush.LineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="MinHeight" Value="{StaticResource Ilu.Size.ControlSecondary}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ilu.Radius.Button}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ilu.Brush.TextMuted}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ilu.Brush.Line}"/>
              <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Implicit default: any plain Button is a secondary button, never the native grey one. -->
  <Style TargetType="Button" BasedOn="{StaticResource Ilu.Button.Secondary}"/>

  <!-- ===== Primary: action fill, white ink ===== -->
  <Style x:Key="Ilu.Button.Primary" TargetType="Button" BasedOn="{StaticResource Ilu.Button.Secondary}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnAction}"/>
    <Setter Property="Background" Value="{StaticResource Ilu.Brush.Action}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual.Gap}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Ilu.Radius.Button}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.ActionPressed}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.ActionPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Transport: raised fill, line-strong edge, text-strong icon ===== -->
  <Style x:Key="Ilu.Button.Transport" TargetType="Button" BasedOn="{StaticResource Ilu.Button.Secondary}">
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.TextStrong}"/>
    <Setter Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="{StaticResource Ilu.Size.ControlSecondary}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ilu.Radius.Button}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ilu.Brush.TextMuted}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ilu.Brush.Line}"/>
              <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Play: Tag = "Paused" (action fill), "Playing" (live fill, dark ink), "AtEnd" (disabled). 52 tall ===== -->
  <Style x:Key="Ilu.Button.Play" TargetType="Button" BasedOn="{StaticResource Ilu.Button.Primary}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="{StaticResource Ilu.Size.ControlPrimary}"/>
    <Setter Property="Width" Value="96"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Ilu.Radius.Button}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.ActionPressed}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.ActionPressed}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Playing">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnLive}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Live}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Tag" Value="Playing"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Live}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Link-style button ("Reset this page to defaults") ===== -->
  <Style x:Key="Ilu.Button.Link" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual.Small}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline"
                       Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.TextStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Toolbar button: 32 x 32, transparent, radius 4 ===== -->
  <Style x:Key="Ilu.Button.Toolbar" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Width" Value="{StaticResource Ilu.Size.ControlToolbar}"/>
    <Setter Property="Height" Value="{StaticResource Ilu.Size.ControlToolbar}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual.Small}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ilu.Radius.Control}"
                  SnapsToDevicePixels="True">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <!-- Tag = the current colour (a brush): shown as a 4 px bar under the icon -->
              <Border x:Name="Bar" Height="4" Margin="6,0,6,3" VerticalAlignment="Bottom"
                      Background="{TemplateBinding Tag}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Live panel tab (DESIGN.md D7): a text button, 32 tall, heading face so its width never changes. Tag = "open"
       for the open tab: text-strong with a 2 px text-strong bar along its bottom edge. Any other tab is text-muted;
       hover text on raised. Built as a plain button on purpose: no TabControl, so no arrow / Home / Ctrl+Tab keys. ===== -->
  <Style x:Key="Ilu.Button.PanelTab" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.TextMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Height" Value="{StaticResource Ilu.Size.PanelTabBar}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual.Small}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
              <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Margin="-12,0" Background="{StaticResource Ilu.Brush.TextStrong}"
                      Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="Tag" Value="open">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.TextStrong}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toolbar toggle: on = pressed fill, text-strong icon, line-strong edge (differs from hover by its edge) -->
  <Style x:Key="Ilu.ToggleButton.Toolbar" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Width" Value="{StaticResource Ilu.Size.ControlToolbar}"/>
    <Setter Property="Height" Value="{StaticResource Ilu.Size.ControlToolbar}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual.Small}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ilu.Radius.Control}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.TextStrong}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ilu.Brush.LineStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Wider toolbar toggle (Size drop-down, zoom, "Link" with a word under the icon) -->
  <Style x:Key="Ilu.ToggleButton.ToolbarWide" TargetType="ToggleButton" BasedOn="{StaticResource Ilu.ToggleButton.Toolbar}">
    <Setter Property="Width" Value="Auto"/>
    <Setter Property="MinWidth" Value="{StaticResource Ilu.Size.ControlToolbar}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ilu.Radius.Control}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.TextStrong}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ilu.Brush.LineStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Colour drop-down toolbar toggle: Tag = current colour brush (4 px bar), opens a swatch popup. -->
  <Style x:Key="Ilu.ToggleButton.ToolbarColour" TargetType="ToggleButton" BasedOn="{StaticResource Ilu.ToggleButton.Toolbar}">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ilu.Radius.Control}"
                  SnapsToDevicePixels="True">
            <Grid>
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,3"/>
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Ilu.Font.Icon}" FontSize="9" Margin="0,0,6,3"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
              <Border Height="4" Margin="6,0,15,3" VerticalAlignment="Bottom" Background="{TemplateBinding Tag}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ilu.Brush.LineStrong}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Segmented switch segments (RadioButton). Outer edge is drawn by the container Border. ===== -->
  <Style x:Key="Ilu.RadioButton.Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Height" Value="{StaticResource Ilu.Size.Segmented}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual.Small}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Canvas}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Blank output toggle: off = secondary look; on = active fill, white ink ===== -->
  <Style x:Key="Ilu.ToggleButton.Blank" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ilu.Brush.LineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Height" Value="{StaticResource Ilu.Size.Segmented}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Ilu.FocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ilu.Radius.Button}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnActive}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Active}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ilu.Brush.Active}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ilu.Brush.Line}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== State chip as a button (Tag = ok | live | idle | active | attention | fault). Never takes focus. ===== -->
  <Style x:Key="Ilu.Button.Chip" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnIdle}"/>
    <Setter Property="Background" Value="{StaticResource Ilu.Brush.Idle}"/>
    <Setter Property="Height" Value="{StaticResource Ilu.Size.Chip}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Ilu.Radius.Chip}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tag" Value="ok">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Ok}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnOk}"/>
      </Trigger>
      <Trigger Property="Tag" Value="live">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Live}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnLive}"/>
      </Trigger>
      <Trigger Property="Tag" Value="idle">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Idle}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnIdle}"/>
      </Trigger>
      <Trigger Property="Tag" Value="active">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Active}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnActive}"/>
      </Trigger>
      <Trigger Property="Tag" Value="attention">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Attention}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnAttention}"/>
      </Trigger>
      <Trigger Property="Tag" Value="fault">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Fault}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnFault}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Same chip look for a non-interactive ContentControl (preview BLANK badge, card chips). -->
  <Style x:Key="Ilu.Chip" TargetType="ContentControl">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnIdle}"/>
    <Setter Property="Background" Value="{StaticResource Ilu.Brush.Idle}"/>
    <Setter Property="Height" Value="{StaticResource Ilu.Size.Chip}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Ilu.Radius.Chip}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tag" Value="ok">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Ok}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnOk}"/>
      </Trigger>
      <Trigger Property="Tag" Value="live">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Live}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnLive}"/>
      </Trigger>
      <Trigger Property="Tag" Value="idle">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Idle}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnIdle}"/>
      </Trigger>
      <Trigger Property="Tag" Value="active">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Active}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnActive}"/>
      </Trigger>
      <Trigger Property="Tag" Value="attention">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Attention}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnAttention}"/>
      </Trigger>
      <Trigger Property="Tag" Value="fault">
        <Setter Property="Background" Value="{StaticResource Ilu.Brush.Fault}"/>
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.OnFault}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
