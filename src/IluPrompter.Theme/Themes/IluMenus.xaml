<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- DESIGN.md "App bar, menus, dialogs": menu = raised, line-strong edge, radius 3, items 32 px, hover pressed,
       shortcut text right-aligned in caption/text-muted. Tooltips: raised, line-strong edge, radius 2. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/IluPrompter.Theme;component/Themes/IluTokens.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="Ilu.Separator" TargetType="Separator">
    <Setter Property="Height" Value="9"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="4,4" Background="{StaticResource Ilu.Brush.LineStrong}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Separator" BasedOn="{StaticResource Ilu.Separator}"/>

  <!-- Menu bar -->
  <Style x:Key="Ilu.Menu" TargetType="Menu">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Menu">
          <Border Background="{TemplateBinding Background}">
            <StackPanel IsItemsHost="True" Orientation="Horizontal" ClipToBounds="False"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Menu" BasedOn="{StaticResource Ilu.Menu}"/>

  <!-- Shared pop-up surface -->
  <ControlTemplate x:Key="Ilu.Menu.Popup" TargetType="ContextMenu">
    <Border Background="{StaticResource Ilu.Brush.Raised}" BorderBrush="{StaticResource Ilu.Brush.LineStrong}"
            BorderThickness="1" CornerRadius="{StaticResource Ilu.Radius.Panel}" Padding="4" SnapsToDevicePixels="True">
      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
    </Border>
  </ControlTemplate>

  <Style x:Key="Ilu.ContextMenu" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="MinWidth" Value="180"/>
    <Setter Property="Template" Value="{StaticResource Ilu.Menu.Popup}"/>
  </Style>
  <Style TargetType="ContextMenu" BasedOn="{StaticResource Ilu.ContextMenu}"/>

  <!-- Menu items. Four roles: TopLevelHeader, TopLevelItem, SubmenuHeader, SubmenuItem. -->
  <ControlTemplate x:Key="Ilu.MenuItem.TopLevelHeader" TargetType="MenuItem">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Ilu.Radius.Control}" Padding="10,0" Height="32">
        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      </Border>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
             Focusable="False" PopupAnimation="None">
        <Border Background="{StaticResource Ilu.Brush.Raised}" BorderBrush="{StaticResource Ilu.Brush.LineStrong}"
                BorderThickness="1" CornerRadius="{StaticResource Ilu.Radius.Panel}" Padding="4" MinWidth="240">
          <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="Ilu.MenuItem.TopLevelItem" TargetType="MenuItem">
    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Ilu.Radius.Control}" Padding="10,0" Height="32"
            SnapsToDevicePixels="True">
      <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="Ilu.MenuItem.SubmenuItem" TargetType="MenuItem">
    <Border x:Name="Bd" Background="Transparent" Height="32" Padding="8,0" SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource Ilu.Font.Icon}" FontSize="12"
                   VerticalAlignment="Center" Visibility="Collapsed"/>
        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" VerticalAlignment="Center"
                   FontSize="13" Foreground="{StaticResource Ilu.Brush.TextMuted}"/>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="Ilu.MenuItem.SubmenuHeader" TargetType="MenuItem">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="Bd" Background="Transparent" Height="32" Padding="8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource Ilu.Font.Icon}" FontSize="10" Margin="24,0,0,0"
                     VerticalAlignment="Center" Foreground="{StaticResource Ilu.Brush.TextMuted}"/>
        </Grid>
      </Border>
      <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" IsOpen="{TemplateBinding IsSubmenuOpen}"
             AllowsTransparency="True" Focusable="False" PopupAnimation="None">
        <Border Background="{StaticResource Ilu.Brush.Raised}" BorderBrush="{StaticResource Ilu.Brush.LineStrong}"
                BorderThickness="1" CornerRadius="{StaticResource Ilu.Radius.Panel}" Padding="4" MinWidth="240">
          <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ilu.Brush.Pressed}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Disabled}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Ilu.MenuItem" TargetType="MenuItem">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <Trigger Property="Role" Value="TopLevelHeader">
        <Setter Property="Template" Value="{StaticResource Ilu.MenuItem.TopLevelHeader}"/>
      </Trigger>
      <Trigger Property="Role" Value="TopLevelItem">
        <Setter Property="Template" Value="{StaticResource Ilu.MenuItem.TopLevelItem}"/>
      </Trigger>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter Property="Template" Value="{StaticResource Ilu.MenuItem.SubmenuHeader}"/>
      </Trigger>
      <Trigger Property="Role" Value="SubmenuItem">
        <Setter Property="Template" Value="{StaticResource Ilu.MenuItem.SubmenuItem}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="MenuItem" BasedOn="{StaticResource Ilu.MenuItem}"/>

  <!-- ===== ToolTip ===== -->
  <Style x:Key="Ilu.ToolTip" TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource Ilu.Font.Ui}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Ilu.Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Ilu.Brush.Raised}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ilu.Brush.LineStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ilu.Radius.Chip}"
                  Padding="{TemplateBinding Padding}" MaxWidth="360" SnapsToDevicePixels="True">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource Ilu.ToolTip}"/>
</ResourceDictionary>
